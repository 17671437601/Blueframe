{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueframe.local/schemas/legacy-behavior.schema.json",
  "title": "Legacy behavior inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "input",
          "observed_state",
          "output",
          "error_behavior",
          "evidence_ref"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "observed_state": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "error_behavior": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
